/**
 * 📦 Schema organizado:
 * ├── 🔐 Admin & Auth (AdminUser, AuditLog)
 * ├── 📝 Form System (FormDriver, FormSubmission, FormDocument, etc)
 * ├── 💰 Payment & Financial (EquipmentPayment, FinancialService)
 * ├── 🎓 Onboarding Events (OnboardingEvent, OnboardingAttendee)
 * └── 📋 Enums (todos al final)
 */

// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ADMIN & AUTH ====================

model AdminUser {
  id      String @id
  clerkId String @unique @map("clerk_id")

  email           String  @unique
  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  fullName        String? @map("full_name")
  phoneNumber     String? @map("phone_number")
  profileImageUrl String? @map("profile_image_url")

  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true) @map("is_active")
  permissions String[]  @default([])

  assignedZones String[] @default([]) @map("assigned_zones")

  metadata Json?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relaciones
  formNotesCreated                FormNote[]               @relation("FormNoteCreatedBy")
  documentsUploaded               FormDocument[]           @relation("DocumentUploadedBy")
  documentReviews                 FormDocument[]           @relation("DocumentReviewedBy")
  finalApprovalsGiven             FormDriver[]             @relation("FinalApprovedBy")
  onboardingEventsOrganized       OnboardingEvent[]        @relation("EventOrganizer")
  onboardingAttendeesInvited      OnboardingAttendee[]     @relation("AttendeeInvitedBy")
  onboardingAttendeesCheckedIn    OnboardingAttendee[]     @relation("AttendeeCheckedInBy")
  onboardingAttendeesCancelled    OnboardingAttendee[]     @relation("AttendeeCancelledBy")
  onboardingAttendeesMarkedNoShow OnboardingAttendee[]     @relation("AttendeeMarkedNoShowBy")
  onboardingAttendeesRescheduled  OnboardingAttendee[]     @relation("AttendeeRescheduledBy")
  onboardingEventsCompleted       OnboardingEvent[]        @relation("EventCompletedBy")
  onboardingRulesOrganized        OnboardingScheduleRule[] @relation("RuleDefaultOrganizer")
  onboardingRulesCreated          OnboardingScheduleRule[] @relation("RuleCreatedBy")
  equipmentPaymentsVerified       EquipmentPayment[]       @relation("PaymentVerifiedBy")
  driverContactsCreated           DriverContact[]          @relation("ContactCreatedBy")
  whatsappMessagesSent            WhatsAppMessage[]        @relation("WhatsAppMessagesSent")
  whatsappTemplatesCreated        WhatsAppTemplate[]       @relation("TemplatesCreated")
  whatsappTemplatesUpdated        WhatsAppTemplate[]       @relation("TemplatesUpdated")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

model AuditLog {
  id String @id @default(cuid())

  // Quién hizo la acción
  userId    String  @map("user_id") // clerkId
  userEmail String? @map("user_email")

  // Qué hizo
  action      AuditAction
  actionType  String      @map("action_type") // "CREATE", "UPDATE", "DELETE", "APPROVE"
  description String?     @db.Text

  // Sobre qué entidad
  entityType String @map("entity_type") // "FormDriver", "Document", "Payment"
  entityId   String @map("entity_id")

  // Metadata de la acción
  changes  Json? // Cambios específicos (before/after)
  metadata Json?

  // Contexto de la request
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model DriverContact {
  id              String        @id @default(cuid())
  formDriverId    String        @map("form_driver_id")
  contactedAt     DateTime      @default(now()) @map("contacted_at")
  contactMethod   ContactMethod @map("contact_method")
  contactedBy     String        @map("contacted_by") // clerkId
  contactedByUser AdminUser     @relation("ContactCreatedBy", fields: [contactedBy], references: [id])
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  formDriver      FormDriver    @relation(fields: [formDriverId], references: [id])

  @@index([formDriverId])
  @@index([contactedAt])
  @@index([contactedBy])
  @@map("driver_contacts")
}

// ==================== FORM SYSTEM ====================

model FormDriver {
  id String @id @default(cuid())

  // Datos personales básicos
  cedula      String
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  fullName    String?   @map("full_name")
  phoneNumber String    @map("phone_number")
  email       String?
  birthDate   DateTime? @map("birth_date")

  // Dirección completa
  department   String? // Departamento
  city         String? // Ciudad
  neighborhood String? // Barrio
  address      String? // Dirección exacta
  addressLat   Float?  @map("address_lat") // Latitud del domicilio
  addressLng   Float?  @map("address_lng") // Longitud del domicilio

  // Vehículo
  hasVehicle   Boolean @default(false) @map("has_vehicle")
  vehicleBrand String? @map("vehicle_brand")
  vehicleModel String? @map("vehicle_model")
  vehicleYear  Int?    @map("vehicle_year")
  vehiclePlate String? @map("vehicle_plate")

  // Documentos legacy (URLs de Vercel Blob) - mantener por compatibilidad
  cedulaPhotoUrl  String? @map("cedula_photo_url")
  licensePhotoUrl String? @map("license_photo_url")
  vehiclePhotoUrl String? @map("vehicle_photo_url")

  // Contacto de emergencia
  emergencyName         String? @map("emergency_name")
  emergencyRelationship String? @map("emergency_relationship")
  emergencyPhone        String? @map("emergency_phone")

  // Zona de trabajo y referencia
  workZone        String? @map("work_zone")
  howHeardAboutUs String? @map("how_heard_about_us")
  referredBy      String? @map("referred_by")

  // Info adicional
  experience        String?
  availability      String[] @default([])
  whenCanStart      String?  @map("when_can_start")
  hasUenoAccount    Boolean  @default(false) @map("has_ueno_account")
  uenoAccountNumber String?  @map("ueno_account_number")
  canInvoice        Boolean  @default(false) @map("can_invoice")

  // Estado del formulario
  status          FormDriverStatus    @default(IN_PROGRESS)
  currentStep     Int                 @default(1)
  completedSteps  Int[]               @default([]) @map("completed_steps")
  documentsStatus FormDocumentsStatus @default(INCOMPLETE) @map("documents_status")

  // On Boarding
  onboardingStatus      OnboardingStatus? @map("onboarding_status")
  onboardingScheduledAt DateTime?         @map("onboarding_scheduled_at")
  onboardingCompletedAt DateTime?         @map("onboarding_completed_at")
  onboardingNotes       String?           @map("onboarding_notes") @db.Text

  // Gestión administrativa
  internalNotes        String?   @map("internal_notes") @db.Text
  assistedCompletion   Boolean   @default(false) @map("assisted_completion") // ✅ NUEVO
  assistedCompletionBy String?   @map("assisted_completion_by") // clerkId del admin
  assistedCompletionAt DateTime? @map("assisted_completion_at")

  // Aprobación final
  finalApprovedBy     String?    @map("final_approved_by") // clerkId
  finalApprovedByUser AdminUser? @relation("FinalApprovedBy", fields: [finalApprovedBy], references: [id])
  finalApprovedAt     DateTime?  @map("final_approved_at")

  // Metadata
  source   String? // web, mobile, referral
  metadata Json?

  // Control de frecuencia de mensajes
  messagesSentCount Int       @default(0) @map("messages_sent_count") // Total de mensajes automáticos enviados
  noContactBefore   DateTime? @map("no_contact_before") // No contactar antes de esta fecha
  lastMessageSentAt DateTime? @map("last_message_sent_at") // Último mensaje automático enviado

  // Portal de autogestión
  accessToken            String?   @unique @map("access_token")
  accessTokenGeneratedAt DateTime? @map("access_token_generated_at")
  lastPortalAccessAt     DateTime? @map("last_portal_access_at")

  // Timestamp del envío del mensaje "postulación aprobada" — candado de
  // idempotencia para que el approve no remande si se llama N veces o si admin
  // rechaza y reaprueba.
  approvalNotifiedAt DateTime? @map("approval_notified_at")

  // Validación RUC (turuc.com.py)
  rucStatus         String?   @default("NOT_CHECKED") @map("ruc_status") // NOT_CHECKED | ACTIVO | INACTIVO | CLAUSURADO | NO_ENCONTRADO | ERROR | etc (string libre, valor crudo del SET)
  rucName           String?   @map("ruc_name") // razonSocial
  rucDv             Int?      @map("ruc_dv") // dígito verificador
  rucIsLegalEntity  Boolean?  @map("ruc_is_legal_entity")
  rucIsPublicEntity Boolean?  @map("ruc_is_public_entity")
  rucLastCheckedAt  DateTime? @map("ruc_last_checked_at")
  rucApiRawResponse Json?     @map("ruc_api_raw_response") // respuesta completa (debug)

  // Admin: marca "RUC Inactivo" (postulante va a corregir su situación fiscal).
  // Cuando es true, el certificado tributario cuenta como completo a los fines del badge.
  rucInactiveWaived     Boolean   @default(false) @map("ruc_inactive_waived")
  rucInactiveWaivedBy   String?   @map("ruc_inactive_waived_by") // clerkId del admin
  rucInactiveWaivedAt   DateTime? @map("ruc_inactive_waived_at")
  rucInactiveWaivedNote String?   @map("ruc_inactive_waived_note") @db.Text

  // Timestamps
  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relaciones
  submissions           FormSubmission[]
  notes                 FormNote[]
  documents             FormDocument[]
  onboardingAttendances OnboardingAttendee[]
  publicBookingSessions PublicBookingSession[]
  equipmentPayments     EquipmentPayment[]
  driverContacts        DriverContact[]
  financialService      FinancialService?
  whatsappMessagesSent  WhatsAppMessage[]
  agentRuns             AgentRun[]

  @@index([cedula])
  @@index([phoneNumber])
  @@index([email])
  @@index([status])
  @@index([lastActivityAt])
  @@index([documentsStatus])
  @@index([onboardingStatus])
  @@index([accessToken])
  @@index([rucStatus])
  @@map("form_drivers")
}

model FormSubmission {
  id           String  @id @default(cuid())
  sessionId    String  @unique // UUID generado en frontend
  formDriverId String? @map("form_driver_id")

  // Progreso
  currentStep Int     @default(1)
  totalSteps  Int     @default(6) // ✅ ACTUALIZADO: ahora son 6 steps
  isComplete  Boolean @default(false)

  // Datos completos del formulario (JSON incremental)
  formData Json @map("form_data")

  // Tracking temporal
  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  completedAt    DateTime? @map("completed_at")

  // Analytics de abandono
  isAbandoned     Boolean   @default(false) @map("is_abandoned")
  abandonedAt     DateTime? @map("abandoned_at")
  abandonedAtStep Int?      @map("abandoned_at_step")

  // Metadata de tracking
  userAgent      String? @map("user_agent")
  ipAddress      String? @map("ip_address")
  referralSource String? @map("referral_source")
  utmSource      String? @map("utm_source")
  utmMedium      String? @map("utm_medium")
  utmCampaign    String? @map("utm_campaign")

  // Relaciones
  formDriver      FormDriver?          @relation(fields: [formDriverId], references: [id], onDelete: SetNull)
  stepCompletions FormStepCompletion[]

  @@index([sessionId])
  @@index([formDriverId])
  @@index([isComplete])
  @@index([isAbandoned])
  @@index([lastActivityAt])
  @@map("form_submissions")
}

model FormStepCompletion {
  id           String @id @default(cuid())
  submissionId String @map("submission_id")

  step     Int // 1-6
  stepName String @map("step_name") // "contact_info", "payment", etc

  // Datos del step específico
  stepData Json @map("step_data")

  // Timestamps
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  timeSpentSeconds Int?      @map("time_spent_seconds")

  // Metadata
  validationErrors Json?   @map("validation_errors")
  wasEdited        Boolean @default(false) @map("was_edited")
  editCount        Int     @default(0) @map("edit_count")

  // Relaciones
  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, step])
  @@index([submissionId])
  @@map("form_step_completions")
}

model FormNote {
  id            String     @id @default(cuid())
  content       String     @db.Text
  formDriverId  String     @map("form_driver_id")
  formDriver    FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)
  createdBy     String     @map("created_by") // clerkId
  createdByUser AdminUser  @relation("FormNoteCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([formDriverId])
  @@index([createdAt])
  @@map("form_notes")
}

model FormDocument {
  id           String @id @default(cuid())
  formDriverId String @map("form_driver_id")

  // Tipo de documento
  documentType DocumentType @map("document_type")

  // Almacenamiento (Vercel Blob)
  blobUrl  String  @map("blob_url")
  fileName String  @map("file_name")
  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size") // bytes

  // Estado y validación
  status FormDocumentStatus @default(PENDING)

  // Notas administrativas
  adminNotes String? @map("admin_notes") @db.Text

  // Quién cargó el documento
  uploadedBy     String?    @map("uploaded_by") // clerkId o "driver"
  uploadedByUser AdminUser? @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])

  // Quién revisó y cuándo
  reviewedBy     String?    @map("reviewed_by") // clerkId
  reviewedByUser AdminUser? @relation("DocumentReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?  @map("reviewed_at")

  // Razón de rechazo
  rejectionReason String? @map("rejection_reason") @db.Text

  // Metadata
  metadata Json?

  // Timestamps
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relaciones
  formDriver FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)

  @@index([formDriverId])
  @@index([documentType])
  @@index([status])
  @@index([uploadedBy])
  @@map("form_documents")
}

// ==================== PAYMENT & FINANCIAL ====================

model EquipmentPayment {
  id           String @id @default(cuid())
  formDriverId String @map("form_driver_id")

  // Información del pago
  paymentMethod String?   @map("payment_method") // TRANSFERENCIA, POS, OTROS
  paymentNumber String?   @map("payment_number") // Últimos 6 dígitos
  invoiceNumber String?   @map("invoice_number") // 001-001-0019089
  amount        Float? // Monto abonado
  paymentDate   DateTime? @map("payment_date")

  // Comprobante de pago (solo para transferencias)
  paymentProofUrl String? @map("payment_proof_url") // URL Vercel Blob

  // Estado del pago
  status         PaymentStatus @default(PENDING)
  verifiedAt     DateTime?     @map("verified_at")
  verifiedBy     String?       @map("verified_by") // clerkId
  verifiedByUser AdminUser?    @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id])

  // Notas administrativas
  adminNotes String? @map("admin_notes") @db.Text

  // Razón de rechazo
  rejectionReason String? @map("rejection_reason") @db.Text

  // Metadata
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  formDriver FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)

  @@index([formDriverId])
  @@index([status])
  @@map("equipment_payments")
}

model FinancialService {
  id           String @id @default(cuid())
  formDriverId String @map("form_driver_id")

  // Facturación
  hasInvoice Boolean @default(false) @map("has_invoice")
  invoiceRuc String? @map("invoice_ruc")

  // Certificado de cumplimiento tributario
  taxComplianceUrl String? @map("tax_compliance_url") // URL Vercel Blob

  // Servicio Conto (contabilidad)
  interestedInConto Boolean @default(false) @map("interested_in_conto")
  contoStatus       String? @map("conto_status") // INTERESTED, CONTACTED, ACTIVE

  // Metadata
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  formDriver FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)

  @@unique([formDriverId])
  @@index([formDriverId])
  @@map("financial_services")
}

model WhatsAppMessage {
  id String @id @default(cuid())

  // Destinatario
  recipientPhone String @map("recipient_phone") // 5491112345678
  recipientName  String @map("recipient_name") // Juan Pérez
  chatId         String @map("chat_id") // 5491112345678@c.us

  // Tipo de mensaje y contenido
  messageType   WhatsAppMessageType @map("message_type")
  step          String? // Para form_incomplete: personal_info, documents, etc
  message       String              @db.Text // Mensaje completo enviado
  messageLength Int                 @map("message_length") // Longitud del mensaje

  // Metadata específica del tipo de mensaje (JSON flexible)
  metadata Json? // { formUrl, date, time, location, meetingUrl, etc }

  // Estado del envío
  status         WhatsAppMessageStatus @default(SENT)
  sentAt         DateTime              @default(now()) @map("sent_at")
  deliveredAt    DateTime?             @map("delivered_at")
  readAt         DateTime?             @map("read_at")
  failedAt       DateTime?             @map("failed_at")
  responseTimeMs Int?                  @map("response_time_ms") // Tiempo que tardó el bot en responder

  // Manejo de errores
  errorMessage String? @map("error_message") @db.Text
  retryCount   Int     @default(0) @map("retry_count")
  maxRetries   Int     @default(3) @map("max_retries")

  // Relación opcional con FormDriver
  formDriverId String?     @map("form_driver_id")
  formDriver   FormDriver? @relation(fields: [formDriverId], references: [id], onDelete: SetNull)

  // Auditoría y origen
  botId String? @map("bot-adquisicion-id") // bot-adquisicion-prod, bot-reactivacion-prod

  source     WhatsAppMessageSource @default(MANUAL) // manual, cron, trigger, api
  sentBy     String?               @map("sent_by") // clerkId del admin que lo envió (si es manual)
  sentByUser AdminUser?            @relation("WhatsAppMessagesSent", fields: [sentBy], references: [id], onDelete: SetNull)

  // Contexto de la request
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([recipientPhone])
  @@index([messageType])
  @@index([status])
  @@index([source])
  @@index([formDriverId])
  @@index([sentBy])
  @@index([sentAt])
  @@index([botId]) // ✅ NUEVO índice
  @@map("whatsapp_messages")
}

model WhatsAppTemplate {
  id String @id @default(cuid())

  // Identificador único para referenciar en código
  key String @unique // capacitaciones, seguimiento_documentos, etc.

  // Información de la plantilla
  name        String // "Info sobre Capacitaciones"
  description String? @db.Text // Descripción de cuándo usar esta plantilla

  // Contenido del mensaje (puede usar {name} como placeholder)
  content String @db.Text

  // Estado
  isActive Boolean @default(true) @map("is_active")
  order    Int     @default(0) // Para ordenar en el UI

  // Categoría opcional
  category String? // general, documentos, capacitacion, pago, etc

  // Estadísticas de uso
  usageCount Int       @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at")

  // Auditoría
  createdBy     String?    @map("created_by")
  createdByUser AdminUser? @relation("TemplatesCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     String?    @map("updated_by")
  updatedByUser AdminUser? @relation("TemplatesUpdated", fields: [updatedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([order])
  @@index([category])
  @@map("whatsapp_templates")
}

// ==================== ONBOARDING EVENTS ====================

model OnboardingEvent {
  id String @id @default(cuid())

  // Vínculo con la regla recurrente que lo generó (null = evento manual / legacy)
  scheduleRuleId String?                 @map("schedule_rule_id")
  scheduleRule   OnboardingScheduleRule? @relation("RuleEvents", fields: [scheduleRuleId], references: [id], onDelete: SetNull)

  // Información del evento (ahora opcionales)
  title       String? // ✅ AHORA OPCIONAL
  description String? @db.Text

  // Snapshot de la regla al momento de materializar (no se mueve si la rule cambia después)
  modality        OnboardingModality? // null = evento legacy
  instructions    String?             @db.Text
  durationMinutes Int?                @map("duration_minutes")
  timezone        String              @default("America/Asuncion")

  // Fecha y hora (lo importante)
  scheduledDate DateTime @map("scheduled_date")
  startTime     String   @map("start_time") // "09:00"
  endTime       String?  @map("end_time") // "12:00"

  // Ubicación
  location        String?
  locationAddress String? @map("location_address")
  meetingLink     String? @map("meeting_link")

  // Capacidad
  maxCapacity     Int? @map("max_capacity")
  currentCapacity Int  @default(0) @map("current_capacity")

  // OCC: previene race conditions al reservar el último cupo
  version Int @default(0)

  // Estado del evento
  status OnboardingEventStatus @default(SCHEDULED)

  // Organización
  organizer     String    @map("organizer") // clerkId
  organizerUser AdminUser @relation("EventOrganizer", fields: [organizer], references: [id])

  // Recordatorios
  reminderSent        Boolean   @default(false) @map("reminder_sent")
  reminderSentAt      DateTime? @map("reminder_sent_at")
  reminderScheduled   Boolean   @default(true) @map("reminder_scheduled")
  reminderHoursBefore Int       @default(24) @map("reminder_hours_before")

  // Completitud
  completedAt     DateTime?  @map("completed_at")
  completedBy     String?    @map("completed_by") // clerkId
  completedByUser AdminUser? @relation("EventCompletedBy", fields: [completedBy], references: [id])

  // Notas
  notes String? @db.Text

  // Metadata
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  attendees OnboardingAttendee[]

  @@index([scheduledDate])
  @@index([status])
  @@index([organizer])
  @@index([scheduleRuleId])
  @@index([scheduledDate, status])
  @@map("onboarding_events")
}

model OnboardingAttendee {
  id String @id @default(cuid())

  // Relaciones
  eventId String          @map("event_id")
  event   OnboardingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  formDriverId String     @map("form_driver_id")
  formDriver   FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)

  // Estado de asistencia
  status OnboardingAttendeeStatus @default(INVITED)

  // Confirmación
  confirmedAt       DateTime? @map("confirmed_at")
  confirmationToken String?   @unique @map("confirmation_token")

  // Asistencia real
  checkedInAt     DateTime?  @map("checked_in_at")
  checkedInBy     String?    @map("checked_in_by") // clerkId
  checkedInByUser AdminUser? @relation("AttendeeCheckedInBy", fields: [checkedInBy], references: [id])

  // No Show
  markedNoShowAt     DateTime?  @map("marked_no_show_at")
  markedNoShowBy     String?    @map("marked_no_show_by") // clerkId
  markedNoShowByUser AdminUser? @relation("AttendeeMarkedNoShowBy", fields: [markedNoShowBy], references: [id])

  // Cancelación
  cancelledAt     DateTime?  @map("cancelled_at")
  cancelledBy     String?    @map("cancelled_by") // clerkId
  cancelledByUser AdminUser? @relation("AttendeeCancelledBy", fields: [cancelledBy], references: [id])
  cancelledReason String?    @map("cancelled_reason") @db.Text

  // Reagendamiento
  rescheduledFrom      String?    @map("rescheduled_from")
  rescheduledAt        DateTime?  @map("rescheduled_at")
  rescheduledBy        String?    @map("rescheduled_by") // clerkId
  rescheduledByUser    AdminUser? @relation("AttendeeRescheduledBy", fields: [rescheduledBy], references: [id])
  rescheduledToEventId String?    @map("rescheduled_to_event_id")

  // Recordatorios
  reminderSent   Boolean   @default(false) @map("reminder_sent")
  reminderSentAt DateTime? @map("reminder_sent_at")

  // Notas
  attendeeNotes String? @map("attendee_notes") @db.Text

  // Metadata
  metadata Json?

  // Timestamps
  invitedAt     DateTime   @default(now()) @map("invited_at")
  invitedBy     String?    @map("invited_by") // clerkId or null for self-service
  invitedByUser AdminUser? @relation("AttendeeInvitedBy", fields: [invitedBy], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([eventId, formDriverId])
  @@index([eventId])
  @@index([formDriverId])
  @@index([status])
  @@map("onboarding_attendees")
}

// ==================== ONBOARDING SCHEDULE RULES ====================
// Reglas recurrentes tipo Calendly Event Type. Cada rule genera N OnboardingEvent
// (instancias materializadas por cron) y soporta excepciones puntuales.

// Ubicaciones físicas reusables para capacitaciones presenciales/híbridas.
// Permite que el admin guarde una vez la dirección + link de Google Maps y la
// reutilice en múltiples reglas (HUB Asunción, sucursal Encarnación, etc.).
model OnboardingLocation {
  id            String  @id @default(cuid())
  name          String  @unique // Nombre interno: "HUB Asunción"
  address       String  // Dirección legible
  googleMapsUrl String  @map("google_maps_url") // URL completa copiada de Google Maps
  notes         String? @db.Text // Referencias / cómo entrar / piso

  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by") // clerkId
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rules OnboardingScheduleRule[]

  @@index([isActive])
  @@map("onboarding_locations")
}

model OnboardingScheduleRule {
  id String @id @default(cuid())

  // Identificación pública
  slug         String  @unique // "capacitacion-presencial-hub"
  title        String
  description  String? @db.Text // Descripción larga (marketing)
  instructions String? @db.Text // Qué traer, cómo prepararse — separado de description

  // Modalidad y ubicación
  modality        OnboardingModality
  // Ubicación: o bien guardada (locationId) o bien ad-hoc (locationAddress + googleMapsUrl)
  locationId      String?             @map("location_id")
  savedLocation   OnboardingLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  location        String? // Nombre legible del lugar ("HUB Asunción") — usado si no hay locationId
  locationAddress String?            @map("location_address")
  googleMapsUrl   String?            @map("google_maps_url") // link copiado desde Google Maps
  // DEPRECATED: lat/lng se reemplazaron por googleMapsUrl + address (no se borran por compat)
  locationLat     Float?             @map("location_lat")
  locationLng     Float?             @map("location_lng")
  meetingLink     String?            @map("meeting_link") // si VIRTUAL/HYBRID
  meetingPlatform String?            @map("meeting_platform") // "Google Meet" | "Zoom" | "Teams" (free text)

  // Recurrencia
  frequency       OnboardingFrequency @default(WEEKLY)
  daysOfWeek      Int[]               @default([]) @map("days_of_week") // 0=domingo..6=sábado
  startTime       String              @map("start_time") // "10:00"
  durationMinutes Int                 @default(120) @map("duration_minutes")
  timezone        String              @default("America/Asuncion")

  // Validez de la regla
  validFrom DateTime  @map("valid_from")
  validTo   DateTime? @map("valid_to") // null = indefinida

  // Reglas de booking
  maxCapacity         Int                   @default(20) @map("max_capacity")
  minNoticeHours      Int                   @default(2) @map("min_notice_hours")
  maxFutureDays       Int                   @default(60) @map("max_future_days")
  bufferBeforeMin     Int                   @default(0) @map("buffer_before_min")
  bufferAfterMin      Int                   @default(0) @map("buffer_after_min")
  cancelDeadlineHours Int                   @default(4) @map("cancel_deadline_hours")
  paymentMode         OnboardingPaymentMode @default(POST_EVENT) @map("payment_mode")

  // Estado / visibilidad
  isActive Boolean @default(true) @map("is_active")
  isPublic Boolean @default(true) @map("is_public") // visible en /capacitaciones

  // Organizador por defecto
  defaultOrganizer String    @map("default_organizer") // clerkId
  organizerUser    AdminUser @relation("RuleDefaultOrganizer", fields: [defaultOrganizer], references: [id])

  // Auditoría
  createdBy     String     @map("created_by") // clerkId
  createdByUser AdminUser? @relation("RuleCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relaciones
  events     OnboardingEvent[]             @relation("RuleEvents")
  exceptions OnboardingScheduleException[]

  @@index([slug])
  @@index([isActive, isPublic])
  @@index([modality])
  @@map("onboarding_schedule_rules")
}

// Excepciones a la regla: feriados (CANCELLED) o cambios puntuales (OVERRIDE).
model OnboardingScheduleException {
  id     String                 @id @default(cuid())
  ruleId String                 @map("rule_id")
  rule   OnboardingScheduleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  date DateTime // Día calendario afectado (00:00 en timezone de la rule)
  type OnboardingExceptionType

  // Override (solo si type = OVERRIDE; null = se usa el valor de la rule)
  overrideStartTime   String? @map("override_start_time")
  overrideDurationMin Int?    @map("override_duration_min")
  overrideMaxCapacity Int?    @map("override_max_capacity")
  overrideMeetingLink String? @map("override_meeting_link")

  reason String? @db.Text

  createdBy String   @map("created_by") // clerkId
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ruleId, date])
  @@index([date])
  @@map("onboarding_schedule_exceptions")
}

// Token efímero para el flujo público de booking. Se emite al postulante elegible
// y se envía por WhatsApp/email post-aprobación. Sin OTP — recovery vía portal viejo.
model PublicBookingSession {
  id String @id @default(cuid())

  formDriverId String     @map("form_driver_id")
  formDriver   FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)

  shareToken String    @unique @map("share_token") // 32 chars, en URL: ?session=XXX
  expiresAt  DateTime  @map("expires_at") // típicamente +30 días desde issue
  usedAt     DateTime? @map("used_at") // se setea al confirmar reserva (no invalida — sirve para tracking)

  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([shareToken])
  @@index([formDriverId])
  @@index([expiresAt])
  @@map("public_booking_sessions")
}

model BackgroundJob {
  id       String    @id @default(uuid())
  type     JobType
  status   JobStatus @default(QUEUED)
  userId   String
  metadata Json
  progress Int       @default(0) // 0-100
  current  Int       @default(0) // Items procesados
  total    Int       @default(0) // Total items
  logs     Json      @default("[]")
  result   Json?

  error String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ==================== BONUS SYSTEM ====================

model BonusAssignment {
  id            String   @id @default(cuid())
  executionDate DateTime @map("execution_date") // Cuándo se ejecutó el proceso
  bonusDate     DateTime @map("bonus_date") // Fecha de los pedidos bonificados
  driverCedula  String   @map("driver_cedula")
  driverName    String?  @map("driver_name")
  orderCount    Int      @map("order_count") // Pedidos que calificaron
  bonusAmount   Decimal  @map("bonus_amount") // Monto total del bono
  extraName     String   @map("extra_name") // "18/1 (9)- 3.000 Gs"
  ruleId        String?  @map("rule_id") // Regla que aplicó

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([executionDate])
  @@index([bonusDate])
  @@index([driverCedula])
  @@index([extraName])
  @@map("bonus_assignments")
}

model BonusRule {
  id             String   @id @default(cuid())
  date           DateTime // Fecha para la que aplica
  startTime      String   @map("start_time") // "14:00"
  endTime        String   @map("end_time") // "18:00"
  zones          String[] // ["Centro", "Villa Morra"] o ["ALL"]
  amountPerOrder Decimal  @map("amount_per_order") // Monto por pedido
  isActive       Boolean  @default(true) @map("is_active")

