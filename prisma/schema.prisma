// ============================================================================
// Agente IA (Anthropic) para procesamiento de postulaciones
// ============================================================================

model AgentRun {
  id           String @id @default(cuid())
  formDriverId String @map("form_driver_id")

  // Estado del run
  status AgentRunStatus @default(PENDING)
  mode   AgentRunMode   @default(DRY_RUN)

  // Resultado
  decision  AgentRunDecision?
  summary   String?           @db.Text
  reasoning String?           @db.Text // razonamiento paso a paso del agente

  // Metadata LLM
  model            String? // claude-haiku-4-5-20251001, etc.
  iterations       Int     @default(0)
  inputTokens      Int?    @map("input_tokens")
  outputTokens     Int?    @map("output_tokens")
  cacheReadTokens  Int?    @map("cache_read_tokens")
  cacheWriteTokens Int?    @map("cache_write_tokens")
  costMicroUsd     Int?    @map("cost_micro_usd") // costo en microdólares (1 unidad = $0.000001 USD). $0.01 = 10_000

  // Auditoría
  triggeredBy String? @map("triggered_by") // clerkId o 'SYSTEM'
  error       String? @db.Text

  // Feedback humano (admin califica si la decisión del agente fue correcta).
  // Usado para medir accuracy y alimentar análisis automático (Fase 2).
  humanFeedback     AgentFeedback? @map("human_feedback")
  humanFeedbackNote String?        @map("human_feedback_note") @db.Text
  humanFeedbackBy   String?        @map("human_feedback_by") // clerkId
  humanFeedbackAt   DateTime?      @map("human_feedback_at")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  formDriver FormDriver    @relation(fields: [formDriverId], references: [id], onDelete: Cascade)
  actions    AgentAction[]

  @@index([formDriverId])
  @@index([status])
  @@index([createdAt])
  @@index([humanFeedback])
  @@map("agent_runs")
}

enum AgentFeedback {
  MATCHES // admin coincide con la decisión del agente
  DOES_NOT_MATCH // admin decidiría distinto
  PARTIAL // algunos puntos bien, otros mal
}

model AgentAction {
  id         String @id @default(cuid())
  agentRunId String @map("agent_run_id")

  // Acción propuesta
  tool      String // ej: 'propose_approve_document', 'propose_send_whatsapp_template'
  input     Json // args del tool call
  reasoning String? @db.Text // por qué el agente eligió esta acción

  // Ejecución
  status          AgentActionStatus @default(PROPOSED)
  approvedBy      String?           @map("approved_by") // clerkId
  approvedAt      DateTime?         @map("approved_at")
  executedAt      DateTime?         @map("executed_at")
  executionResult Json?             @map("execution_result")
  executionError  String?           @map("execution_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([status])
  @@map("agent_actions")
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

enum AgentRunMode {
  DRY_RUN // solo simula, no crea propuestas persistentes
  REAL // crea AgentActions status=PROPOSED para review admin
}

enum AgentRunDecision {
  APPROVED // postulación lista para avanzar
  NEEDS_REVIEW // casos ambiguos, requiere humano
  REJECTED // motivos claros para rechazar
}

enum AgentActionStatus {
  PROPOSED // agente propuso, esperando aprobación
  APPROVED // admin aprobó, pendiente de ejecutar
  EXECUTED // ya se ejecutó
  REJECTED // admin rechazó la propuesta
  FAILED // falló al ejecutar
}

// Configuración runtime del agente. Singleton: una sola fila con isActive=true.
// Permite iterar sobre el prompt y constantes operativas sin necesidad de deploy.
// - systemPromptAddendum se concatena al SYSTEM_PROMPT de código.
// - pipelineNotes / toolsNotes son texto libre (NO se ejecutan) — sirven como
//   canal de feedback estructurado para que el dev las aplique después en código.
// - Las constantes operativas (max imágenes, target size, etc.) se leen runtime
//   con fallback a los valores del código.
model AgentPromptOverride {
  id String @id @default(cuid())

  isActive Boolean @default(true) @map("is_active")

  // Si está presente, reemplaza el SYSTEM_PROMPT del código. Si es null, se usa
  // el del código. En ambos casos, systemPromptAddendum se concatena al final.
  systemPromptOverride String? @map("system_prompt_override") @db.Text
  systemPromptAddendum String? @map("system_prompt_addendum") @db.Text
  pipelineNotes        String? @map("pipeline_notes") @db.Text
  toolsNotes           String? @map("tools_notes") @db.Text

  maxCedulaImages      Int?    @map("max_cedula_images")
  targetImageBytes     Int?    @map("target_image_bytes")
  rucRefreshMaxAgeDays Int?    @map("ruc_refresh_max_age_days")
  haikuModelOverride   String? @map("haiku_model_override")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // clerkId

  @@index([isActive])
  @@map("agent_prompt_overrides")
}
