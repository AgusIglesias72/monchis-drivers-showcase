// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AdminUser - ACTUALIZADO ====================
model AdminUser {
  id      String @id
  clerkId String @unique @map("clerk_id")

  email           String  @unique
  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  fullName        String? @map("full_name")
  phoneNumber     String? @map("phone_number")
  profileImageUrl String? @map("profile_image_url")

  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true) @map("is_active")
  permissions String[]  @default([])

  assignedZones String[] @default([]) @map("assigned_zones")

  metadata Json?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relaciones ACTUALIZADAS
  formNotesCreated       FormNote[]           @relation("FormNoteCreatedBy")
  driverNotesCreated     DriverNote[]         @relation("DriverNoteCreatedBy")
  documentsUploaded      FormDocument[]       @relation("DocumentUploadedBy") // NUEVO
  documentReviews        FormDocument[]       @relation("DocumentReviewedBy")
  // ELIMINADO: documentDeletes
  activitiesLogged       DriverActivity[]     @relation("ActivityLoggedBy")
  // ELIMINADO: driversAssigned
  finalApprovalsGiven    FormDriver[]         @relation("FinalApprovedBy")
  onboardingsScheduled   OnboardingSchedule[] @relation("OnboardingScheduledBy")
  onboardingsCompleted   OnboardingSchedule[] @relation("OnboardingCompletedBy")
  onboardingsCancelled   OnboardingSchedule[] @relation("OnboardingCancelledBy")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}


enum AdminRole {
  SUPER_ADMIN // Acceso total
  ADMIN       // Administrador normal
  OPERATOR    // Operador (acciones limitadas)
  VIEWER      // Solo lectura
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id String @id @default(cuid())

  // Quién hizo la acción
  userId    String  @map("user_id") // clerkId
  userEmail String? @map("user_email") // Para facilitar búsquedas

  // Qué hizo
  action      AuditAction
  actionType  String      @map("action_type") // "CREATE", "UPDATE", "DELETE", "APPROVE", etc
  description String?     @db.Text

  // Sobre qué entidad
  entityType String @map("entity_type") // "FormDriver", "Document", "Driver"
  entityId   String @map("entity_id")

  // Metadata de la acción
  changes  Json? // Cambios específicos (before/after)
  metadata Json?

  // Contexto de la request
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  // Drivers
  DRIVER_CREATED
  DRIVER_UPDATED
  DRIVER_STATUS_CHANGED
  DRIVER_ASSIGNED
  DRIVER_APPROVED
  DRIVER_REJECTED

  // Documentos
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_DELETED

  // Onboarding
  ONBOARDING_SCHEDULED
  ONBOARDING_COMPLETED
  ONBOARDING_CANCELLED

  // Notas
  NOTE_CREATED
  NOTE_UPDATED
  NOTE_DELETED

  // Sistema
  USER_LOGIN
  USER_LOGOUT
  SETTINGS_CHANGED

  // Otros
  OTHER
}

// ==================== ONBOARDING SCHEDULES ====================

model OnboardingSchedule {
  id String @id @default(cuid())

  formDriverId String     @map("form_driver_id")
  formDriver   FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)

  // Quién lo agendó
  scheduledBy      String    @map("scheduled_by") // clerkId del admin
  scheduledByEmail String?   @map("scheduled_by_email")
  scheduledByUser  AdminUser @relation("OnboardingScheduledBy", fields: [scheduledBy], references: [id])

  // Detalles del agendamiento
  scheduledFor DateTime @map("scheduled_for")
  location     String?
  notes        String?  @db.Text

  // Estado
  status OnboardingScheduleStatus @default(SCHEDULED)

  // Quién completó (si aplica)
  completedBy     String?    @map("completed_by") // clerkId
  completedByUser AdminUser? @relation("OnboardingCompletedBy", fields: [completedBy], references: [id])
  completedAt     DateTime?  @map("completed_at")

  // Quién canceló (si aplica)
  cancelledBy     String?    @map("cancelled_by") // clerkId
  cancelledByUser AdminUser? @relation("OnboardingCancelledBy", fields: [cancelledBy], references: [id])
  cancelledAt     DateTime?  @map("cancelled_at")
  cancelReason    String?    @db.Text @map("cancel_reason")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([formDriverId])
  @@index([scheduledBy])
  @@index([scheduledFor])
  @@index([status])
  @@map("onboarding_schedules")
}

enum OnboardingScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

// ==================== FormDocument - ACTUALIZADO ====================
model FormDocument {
  id           String @id @default(cuid())
  formDriverId String @map("form_driver_id")

  // Tipo de documento
  documentType DocumentType @map("document_type")

  // Almacenamiento (Vercel Blob)
  blobUrl  String  @map("blob_url")
  fileName String  @map("file_name")
  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size") // bytes

  // Estado y validación del documento individual
  status FormDocumentStatus @default(PENDING)

  // Notas administrativas sobre este documento específico
  adminNotes String? @db.Text @map("admin_notes")

  // Quién cargó el documento (puede ser admin o el propio driver desde el form)
  uploadedBy     String?    @map("uploaded_by") // clerkId del admin O "driver" si lo subió desde el form
  uploadedByUser AdminUser? @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])

  // Quién revisó y cuándo
  reviewedBy     String?    @map("reviewed_by") // clerkId del admin
  reviewedByUser AdminUser? @relation("DocumentReviewedBy", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?  @map("reviewed_at")

  // Razón de rechazo si aplica (cuando status = REJECTED)
  rejectionReason String? @db.Text @map("rejection_reason")

  // Metadata adicional
  metadata Json?

  // Timestamps
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relaciones
  formDriver FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)

  @@index([formDriverId])
  @@index([documentType])
  @@index([status])
  @@index([uploadedBy])
  @@map("form_documents")
}

// ==================== FormDriver - ACTUALIZADO ====================
model FormDriver {
  id String @id @default(cuid())

  // Datos personales básicos
  cedula      String
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  fullName    String?   @map("full_name")
  phoneNumber String    @map("phone_number")
  email       String?
  birthDate   DateTime? @map("birth_date")

  // Dirección completa
  department   String? // Departamento
  city         String? // Ciudad
  neighborhood String? // Barrio (Barrio)
  address      String? // Dirección exacta

  // Vehículo
  hasVehicle   Boolean @default(false) @map("has_vehicle")
  vehicleBrand String? @map("vehicle_brand")
  vehicleModel String? @map("vehicle_model")
  vehicleYear  Int?    @map("vehicle_year")
  vehiclePlate String? @map("vehicle_plate")

  // Documentos (URLs de Vercel Blob) - LEGACY, mantener por compatibilidad
  cedulaPhotoUrl  String? @map("cedula_photo_url")
  licensePhotoUrl String? @map("license_photo_url")
  vehiclePhotoUrl String? @map("vehicle_photo_url")

  // Contacto de emergencia
  emergencyName         String? @map("emergency_name")
  emergencyRelationship String? @map("emergency_relationship")
  emergencyPhone        String? @map("emergency_phone")

  // Zona de trabajo y referencia
  workZone        String? @map("work_zone")
  howHeardAboutUs String? @map("how_heard_about_us")
  referredBy      String? @map("referred_by")

  // Info adicional
  experience        String?
  availability      String[] @default([])
  whenCanStart      String?  @map("when_can_start")
  hasUenoAccount    Boolean  @default(false) @map("has_ueno_account")
  uenoAccountNumber String?  @map("ueno_account_number")
  canInvoice        Boolean  @default(false) @map("can_invoice")

  // Estado del formulario
  status         FormDriverStatus @default(IN_PROGRESS)
  currentStep    Int              @default(1)
  completedSteps Int[]            @default([]) @map("completed_steps")

  // Estado general de documentos
  documentsStatus FormDocumentsStatus @default(INCOMPLETE) @map("documents_status")

  // On Boarding
  onboardingStatus      OnboardingStatus? @map("onboarding_status")
  onboardingScheduledAt DateTime?         @map("onboarding_scheduled_at")
  onboardingCompletedAt DateTime?         @map("onboarding_completed_at")
  onboardingNotes       String?           @db.Text @map("onboarding_notes")

  // Gestión administrativa interna
  // ELIMINADO: assignedTo y assignedToUser (múltiples admins pueden accionar)
  internalNotes String? @db.Text @map("internal_notes") // Notas generales del proceso

  // Aprobación final (quien da el OK final)
  finalApprovedBy     String?    @map("final_approved_by") // clerkId del admin
  finalApprovedByUser AdminUser? @relation("FinalApprovedBy", fields: [finalApprovedBy], references: [id])
  finalApprovedAt     DateTime?  @map("final_approved_at")

  // Metadata
  source   String? // web, mobile, referral
  metadata Json?

  // Timestamps
  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relaciones
  submissions         FormSubmission[]
  notes               FormNote[]
  documents           FormDocument[]
  onboardingSchedules OnboardingSchedule[]

  @@index([cedula])
  @@index([phoneNumber])
  @@index([email])
  @@index([status])
  @@index([lastActivityAt])
  @@index([documentsStatus])
  @@index([onboardingStatus])
  @@map("form_drivers")
}

model FormNote {
  id           String     @id @default(cuid())
  content      String     @db.Text
  formDriverId String     @map("form_driver_id")
  formDriver   FormDriver @relation(fields: [formDriverId], references: [id], onDelete: Cascade)
  createdBy    String     @map("created_by") // clerkId del admin
  createdByUser AdminUser @relation("FormNoteCreatedBy", fields: [createdBy], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([formDriverId])
  @@index([createdAt])
  @@map("form_notes")
}

model FormSubmission {
  id           String  @id @default(cuid())
  sessionId    String  @unique // UUID generado en frontend
  formDriverId String? @map("form_driver_id") // Se asigna después del Step 1

  // Progreso
  currentStep Int     @default(1)
  totalSteps  Int     @default(7)
  isComplete  Boolean @default(false)

  // Datos completos del formulario (JSON incremental)
  formData Json @map("form_data")

  // Tracking temporal
  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  completedAt    DateTime? @map("completed_at")

  // Analytics de abandono
  isAbandoned     Boolean   @default(false) @map("is_abandoned")
  abandonedAt     DateTime? @map("abandoned_at")
  abandonedAtStep Int?      @map("abandoned_at_step")

  // Metadata de tracking
  userAgent      String? @map("user_agent")
  ipAddress      String? @map("ip_address")
  referralSource String? @map("referral_source")
  utmSource      String? @map("utm_source")
  utmMedium      String? @map("utm_medium")
  utmCampaign    String? @map("utm_campaign")

  // Relaciones
  formDriver      FormDriver?          @relation(fields: [formDriverId], references: [id], onDelete: SetNull)
  stepCompletions FormStepCompletion[]

  @@index([sessionId])
  @@index([formDriverId])
  @@index([isComplete])
  @@index([isAbandoned])
  @@index([lastActivityAt])
  @@map("form_submissions")
}

model FormStepCompletion {
  id           String @id @default(cuid())
  submissionId String @map("submission_id")

  step     Int    // 1-7
  stepName String @map("step_name") // "contact_info", "location", etc

  // Datos del step específico
  stepData Json @map("step_data")

  // Timestamps
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  timeSpentSeconds Int?      @map("time_spent_seconds")

  // Metadata
  validationErrors Json?   @map("validation_errors") // Si hubo errores
  wasEdited        Boolean @default(false) @map("was_edited") // Si volvió a editar
  editCount        Int     @default(0) @map("edit_count")

  // Relaciones
  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, step]) // Un step por submission
  @@index([submissionId])
  @@map("form_step_completions")
}

// ==================== ENUMS PARA FORMULARIO ====================

enum FormDriverStatus {
  IN_PROGRESS      // Completando formulario
  COMPLETED        // Formulario completado
  ABANDONED        // Abandonó el proceso
  SUBMITTED        // Enviado para revisión
  UNDER_REVIEW     // En revisión administrativa
  DOCS_PENDING     // Esperando correcciones de docs
  APPROVED         // Aprobado por admin
  READY_ONBOARDING // Listo para On Boarding
  ONBOARDING       // En proceso de On Boarding
  ACTIVE           // Activo como driver
  REJECTED         // Rechazado
}

enum FormDocumentStatus {
  PENDING     // Subido, esperando revisión
  IN_REVIEW   // En proceso de revisión
  APPROVED    // Aprobado por admin
  REJECTED    // Rechazado - necesita resubir
  RESUBMITTED // Re-subido después de rechazo
}

enum FormDocumentsStatus {
  INCOMPLETE  // Faltan documentos
  PENDING     // Todos subidos, esperando revisión
  IN_REVIEW   // En proceso de revisión
  CORRECTIONS // Algunos rechazados, esperando correcciones
  APPROVED    // Todos aprobados
}

enum OnboardingStatus {
  NOT_READY   // No cumple condiciones aún
  READY       // Listo para agendar
  SCHEDULED   // On boarding agendado
  IN_PROGRESS // En proceso
  COMPLETED   // Completado
  CANCELLED   // Cancelado
  NO_SHOW     // No se presentó
}

// ==================== VEHÍCULOS (EXISTENTE) ====================
model Vehicle {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  // Datos del vehículo
  brand String?      // Marca
  model String?      // Modelo
  year  Int?         // Año
  plate String?      @unique // Chapa/Placa
  color String?      // Color
  type  VehicleType? // Tipo (MOTO, AUTO, etc)

  // Estado y documentación
  isActive        Boolean   @default(true) @map("is_active")
  hasInsurance    Boolean   @default(false) @map("has_insurance")
  insuranceExpiry DateTime? @map("insurance_expiry")

  // Metadata
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([plate])
  @@map("vehicles")
}

// ==================== CONTACTOS DE EMERGENCIA ====================
model EmergencyContact {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  // Datos del contacto
  name             String  // Nombre completo
  relationship     String? // Parentesco
  phoneNumber      String  @map("phone_number")
  alternativePhone String? @map("alternative_phone")

  // Prioridad
  isPrimary Boolean @default(true) @map("is_primary")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("emergency_contacts")
}

// ==================== PAGOS DE EQUIPAMIENTO ====================
model EquipmentPayment {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  // Información del pago
  paymentMethod String?   @map("payment_method") // FORMA DE PAGO
  paymentNumber String?   @map("payment_number") // NRO COMP. DE PAGO
  invoiceNumber String?   @map("invoice_number") // NRO DE FACTURA
  amount        Float?    // MONTO ENTREGA
  paymentDate   DateTime? @map("payment_date") // Fecha del pago (del comprobante)

  // Comprobante de pago
  paymentProofId  String? @map("payment_proof_id") // Drive ID del comprobante
  paymentProofUrl String? @map("payment_proof_url")

  // Estado del pago
  status     PaymentStatus @default(PENDING)
  verifiedAt DateTime?     @map("verified_at")
  verifiedBy String?       @map("verified_by")

  // Metadata
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("equipment_payments")
}

// ==================== SERVICIOS FINANCIEROS (actualizado) ====================
model FinancialService {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  // Facturación
  hasInvoice Boolean @default(false) @map("has_invoice")
  invoiceRuc String? @map("invoice_ruc")

  // Certificado de cumplimiento tributario
  taxComplianceId  String? @map("tax_compliance_id") // Drive ID del certificado
  taxComplianceUrl String? @map("tax_compliance_url")

  // Servicio Conto (contabilidad)
  interestedInConto Boolean @default(false) @map("interested_in_conto")
  contoStatus       String? @map("conto_status") // INTERESTED, CONTACTED, ACTIVE, etc

  // Ueno Bank
  hasUenoAccount    Boolean @default(false) @map("has_ueno_account")
  uenoAccountNumber String? @map("ueno_account_number")

  // Metadata
  metadata Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId])
  @@index([driverId])
  @@map("financial_services")
}

// ==================== DRIVER (actualizado) ====================
model Driver {
  id String @id @default(cuid())

  // Datos personales básicos
  cedula      String    @unique
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  fullName    String?   @map("full_name")
  phoneNumber String    @unique @map("phone_number")
  email       String?   @unique
  birthDate   DateTime? @map("birth_date")
  nationality String?
  sex         String?

  // Dirección completa
  department   String? // Departamento
  city         String? // Ciudad
  neighborhood String? // Barrio
  address      String? // Dirección exacta

  // Estado del driver
  status    DriverStatus @default(PENDING)
  isEnabled Boolean      @default(false) @map("is_enabled")

  // Datos de actividad (CRÍTICO para churn)
  lastTripAt            DateTime? @map("last_trip_at")
  firstTripAt           DateTime? @map("first_trip_at")
  totalTrips            Int       @default(0) @map("total_trips")
  daysInactive          Int?      @map("days_inactive")
  daysSinceRegistration Int?      @map("days_since_registration")

  // Segmentación de Churn
  churnSegment     ChurnSegment @default(NEW)
  churnScore       Float?       @map("churn_score")
  lastChurnCheckAt DateTime?    @map("last_churn_check_at")

  // Onboarding Journey
  onboardingStage   OnboardingStage @default(REGISTERED)
  onboardingStartAt DateTime?       @map("onboarding_start_at")
  onboardingEndAt   DateTime?       @map("onboarding_end_at")

  // Documentación
  documentStatus DocumentStatus @default(PENDING)
  documents      Document[]

  // Relaciones
  vehicles          Vehicle[]
  emergencyContacts EmergencyContact[]
  financialService  FinancialService?
  equipmentPayments EquipmentPayment[]
  campaigns         CampaignRecipient[]
  messages          Message[]
  activities        DriverActivity[]
  notes             DriverNote[]

  // Metadata
  source       String?
  referralCode String?  @map("referral_code")
  tags         String[] @default([])
  metadata     Json?

  // Timestamps
  registeredAt DateTime @default(now()) @map("registered_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([churnSegment])
  @@index([status])
  @@index([lastTripAt])
  @@index([phoneNumber])
  @@index([cedula])
  @@map("drivers")
}

// ==================== DOCUMENTOS ====================
model Document {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  // Tipo y categoría del documento
  type     DocumentType
  category DocumentCategory @default(REQUIRED)

  // Referencias a Google Drive (NO almacenamos archivos)
  driveFileId String? @unique @map("drive_file_id")
  driveUrl    String? @map("drive_url")
  fileName    String  @map("file_name")
  mimeType    String? @map("mime_type")
  fileSize    Int?    @map("file_size") // en bytes

  // Validación con IA
  status          ValidationStatus @default(PENDING)
  aiValidation    Json?            @map("ai_validation") // Respuesta completa de Claude
  extractedData   Json?            @map("extracted_data") // Datos extraídos
  confidenceScore Float?           @map("confidence_score") // 0-100
  validatedAt     DateTime?        @map("validated_at")
  validatedBy     String?          @map("validated_by") // SYSTEM o user ID

  // Razones de rechazo o notas
  rejectionReason String? @map("rejection_reason")
  notes           String?

  // Timestamps
  uploadedAt DateTime  @default(now()) @map("uploaded_at")
  expiresAt  DateTime? @map("expires_at") // Para docs que expiran
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Metadata
  metadata Json?

  // Relaciones
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, type])
  @@index([status])
  @@map("documents")
}

// ==================== CAMPAÑAS ====================
model Campaign {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Tipo y segmentación
  type           CampaignType
  targetSegments ChurnSegment[] // A qué segmentos apunta
  targetTags     String[]       @default([]) // Tags adicionales para filtrar

  // Estado
  status CampaignStatus @default(DRAFT)

  // Configuración del mensaje
  channel         CampaignChannel @default(WHATSAPP)
  messageTemplate String          @map("message_template")
  variables       Json? // Variables para personalización

  // Programación
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  completedAt DateTime? @map("completed_at")

  // Métricas
  totalRecipients Int @default(0) @map("total_recipients")
  sentCount       Int @default(0) @map("sent_count")
  deliveredCount  Int @default(0) @map("delivered_count")
  readCount       Int @default(0) @map("read_count")
  responseCount   Int @default(0) @map("response_count")

  // Relaciones
  recipients CampaignRecipient[]

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([status])
  @@index([type])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String @id @default(cuid())
  campaignId String @map("campaign_id")
  driverId   String @map("driver_id")

  // Estado del mensaje
  status      MessageStatus @default(PENDING)
  sentAt      DateTime?     @map("sent_at")
  deliveredAt DateTime?     @map("delivered_at")
  readAt      DateTime?     @map("read_at")
  respondedAt DateTime?     @map("responded_at")
  failedAt    DateTime?     @map("failed_at")

  // Detalles
  messageId    String? @map("message_id") // ID de Twilio
  errorMessage String? @map("error_message")
  response     String? // Si el driver responde

  // Relaciones
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([campaignId, driverId])
  @@index([driverId])
  @@index([status])
  @@map("campaign_recipients")
}

// ==================== MENSAJES ====================
model Message {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  // Tipo y contenido
  type      MessageType
  channel   CampaignChannel  @default(WHATSAPP)
  direction MessageDirection @default(OUTBOUND)

  // Contenido
  content  String
  mediaUrl String? @map("media_url")

  // Estado y tracking
  status          MessageStatus @default(PENDING)
  twilioMessageId String?       @unique @map("twilio_message_id")
  twilioStatus    String?       @map("twilio_status")

  // Timestamps de eventos
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  failedAt    DateTime? @map("failed_at")

  // Error handling
  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")
  retryCount   Int     @default(0) @map("retry_count")

  // Relaciones
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([driverId])
  @@index([status])
  @@index([twilioMessageId])
  @@map("messages")
}

// ==================== ACTIVIDAD ====================
model DriverActivity {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  type        ActivityType
  description String
  metadata    Json?

  performedAt DateTime @default(now()) @map("performed_at")
  performedBy String?  @map("performed_by") // SYSTEM o clerkId

  // Relación con admin user (si es manual)
  loggedBy     String?    @map("logged_by") // clerkId (null si es automático)
  loggedByUser AdminUser? @relation("ActivityLoggedBy", fields: [loggedBy], references: [id])

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([type])
  @@map("driver_activities")
}

// ==================== NOTAS ====================
model DriverNote {
  id       String @id @default(cuid())
  driverId String @map("driver_id")

  content     String
  isImportant Boolean @default(false) @map("is_important")

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by") // clerkId del admin
  createdByUser AdminUser @relation("DriverNoteCreatedBy", fields: [createdBy], references: [id])

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("driver_notes")
}

// ==================== ENUMS ====================

enum DriverStatus {
  PENDING     // Recién registrado
  IN_REVIEW   // En proceso de revisión
  APPROVED    // Aprobado
  ACTIVE      // Activo (ha tomado turnos)
  INACTIVE    // Inactivo temporalmente
  SUSPENDED   // Suspendido
  REJECTED    // Rechazado
  BLACKLISTED // En lista negra
}

enum ChurnSegment {
  NEW             // Registrado pero nunca tomó un turno
  ONBOARDING      // En primeros 30 días con actividad
  ACTIVE          // Activo en últimos 7 días
  AT_RISK         // 7-14 días sin actividad
  EARLY_CHURN     // 15-21 días sin actividad
  MODERATE_CHURN  // 22-30 días sin actividad
  LATE_CHURN      // 31-60 días sin actividad
  SEVERE_CHURN    // 61-90 días sin actividad
  CRITICAL_CHURN  // 91-180 días sin actividad
  LOST            // +180 días sin actividad
  NEVER_ACTIVATED // +30 días desde registro, nunca tomó turno
}

enum OnboardingStage {
  REGISTERED           // Se registró
