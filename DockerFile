FROM mcr.microsoft.com/playwright:v1.56.1-jammy

WORKDIR /app

# Copiar package files
COPY package*.json ./

# Instalar dependencias
RUN npm ci

# Copiar el resto del código
COPY . .

# Variables de entorno para el build
ARG DATABASE_URL
ARG GOOGLE_SERVICE_ACCOUNT_EMAIL
ARG GOOGLE_PRIVATE_KEY
ARG GOOGLE_SHEETS_ID
ARG GOOGLE_DRIVE_FOLDER_ID
ARG GOOGLE_OAUTH_CLIENT_ID
ARG GOOGLE_OAUTH_CLIENT_SECRET
ARG GOOGLE_OAUTH_REFRESH_TOKEN
ARG APP_EMAIL
ARG APP_PASSWORD
ARG APP_LOGIN_URL
ARG APP_DRIVERS_URL
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG CLERK_SECRET_KEY
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ARG ANTHROPIC_API_KEY
ARG BLOB_READ_WRITE_TOKEN

ENV DATABASE_URL=$DATABASE_URL
ENV GOOGLE_SERVICE_ACCOUNT_EMAIL=$GOOGLE_SERVICE_ACCOUNT_EMAIL
ENV GOOGLE_PRIVATE_KEY=$GOOGLE_PRIVATE_KEY
ENV GOOGLE_SHEETS_ID=$GOOGLE_SHEETS_ID
ENV GOOGLE_DRIVE_FOLDER_ID=$GOOGLE_DRIVE_FOLDER_ID
ENV GOOGLE_OAUTH_CLIENT_ID=$GOOGLE_OAUTH_CLIENT_ID
ENV GOOGLE_OAUTH_CLIENT_SECRET=$GOOGLE_OAUTH_CLIENT_SECRET
ENV GOOGLE_OAUTH_REFRESH_TOKEN=$GOOGLE_OAUTH_REFRESH_TOKEN
ENV APP_EMAIL=$APP_EMAIL
ENV APP_PASSWORD=$APP_PASSWORD
ENV APP_LOGIN_URL=$APP_LOGIN_URL
ENV APP_DRIVERS_URL=$APP_DRIVERS_URL
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV CLERK_SECRET_KEY=$CLERK_SECRET_KEY
ENV NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ENV ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
ENV BLOB_READ_WRITE_TOKEN=$BLOB_READ_WRITE_TOKEN

# Generar Prisma client
RUN npx prisma generate

# Build de Next.js
RUN npm run build

# Exponer puerto
EXPOSE 3000

ENV PORT=3000

# Iniciar
CMD ["npm", "start"]