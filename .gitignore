# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# WhatsApp bot (workspace separado en apps/whatsapp-bot/)
/apps/whatsapp-bot/node_modules
/apps/whatsapp-bot/.wwebjs_auth
/apps/whatsapp-bot/.wwebjs_cache
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# backups locales de migraciones (contienen URLs de blobs reales)
/backups/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright-mcp: artefactos locales de sesiones (logs, snapshots)
/.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# claude code: settings.local.json puede tener comandos con credenciales inline
.claude/settings.local.json

# scripts locales (no commitear)
/scripts/admin2-test.ts

# tokens / credenciales que NUNCA deben ir al repo
*token*.json
*credentials*.json
*service-account*.json
*.p12
*.pfx
*.key

# datos sensibles ad-hoc (xlsx con PII de postulantes, dumps, etc.)
*.xlsx
*.xls
*.csv
!public/**/*.csv

# playwright e2e
/test-results/
/playwright-report/
/e2e/.auth/
